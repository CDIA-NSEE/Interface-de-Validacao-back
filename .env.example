# Application
DATABASE_URL=sqlite:///./ecg_review.db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
RESET_DATABASE_ON_STARTUP=false

# Authentication
AUTH_SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_USER_USERNAME=dr.joao
DEFAULT_USER_PASSWORD=change-this-doctor-password
DEFAULT_USER_FULL_NAME=Dr. Joao
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_ADMIN_FULL_NAME=Administrador Operacional
BP_ALLOWED_EMAIL_DOMAINS=

# ECG metadata and validation cycle
METADATA_DATABASE_PATH=data/database/metadata.db
VALIDATION_CYCLE_DAY=
VALIDATION_ACTIVE_DIAGNOSIS=

# Support contact shown in the app
SUPPORT_CONTACT_LABEL=Suporte operacional
SUPPORT_CONTACT_TYPE=text
SUPPORT_CONTACT_VALUE=Definir canal oficial BP/NSEE

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
BACKEND_CORS_ORIGIN_REGEX=^http://192\.168\.\d{1,3}\.\d{1,3}:517[3-5]$
